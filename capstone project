<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SAIRMS — Student Academic Information & Record Management System</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        navy: {
                            800: '#1e293b',
                            900: '#0f172a',
                            950: '#090d16',
                        },
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Print Media Styles for Official Transcript */
        @media print {
            body * {
                visibility: hidden;
            }
            #transcript-print-area, #transcript-print-area * {
                visibility: visible;
            }
            #transcript-print-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                padding: 20px;
                background: white !important;
                color: black !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-brand-100 selection:text-brand-900">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Main App Wrapper -->
    <div class="min-h-screen flex flex-col lg:flex-row">

        <!-- Mobile Header -->
        <header class="lg:hidden bg-navy-900 text-white px-4 py-3 flex items-center justify-between sticky top-0 z-30 shadow-md">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center font-display font-bold text-white shadow-inner">
                    S
                </div>
                <div>
                    <span class="font-display font-bold tracking-tight text-lg block leading-none">SAIRMS</span>
                    <span class="text-[10px] text-slate-400 uppercase tracking-wider">Academic Registrar</span>
                </div>
            </div>
            <button id="mobile-menu-btn" class="p-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white focus:outline-none">
                <i data-lucide="menu" class="w-6 h-6"></i>
            </button>
        </header>

        <!-- Sidebar Navigation -->
        <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-68 bg-navy-900 text-slate-300 transform -translate-x-full lg:translate-x-0 lg:static lg:inset-0 transition-transform duration-200 ease-in-out flex flex-col w-64 shrink-0 border-r border-slate-800">
            <!-- Brand Logo -->
            <div class="p-6 border-b border-slate-800/80 hidden lg:flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white font-display font-extrabold text-xl shadow-lg shadow-brand-950/50">
                    <i data-lucide="graduation-cap" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="font-display font-bold text-white text-lg tracking-tight leading-tight">SAIRMS</h1>
                    <p class="text-[11px] text-slate-400 font-medium tracking-wide">Academic Information</p>
                </div>
            </div>

            <!-- Academic Term Pill -->
            <div class="px-4 pt-5 pb-2">
                <div class="bg-slate-800/70 border border-slate-700/70 rounded-xl p-3">
                    <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
                        <span>Active Term</span>
                        <span class="inline-flex items-center gap-1 text-emerald-400 font-medium">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Live
                        </span>
                    </div>
                    <div class="text-sm font-semibold text-white">Fall Semester 2026–27</div>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
                <button onclick="switchTab('dashboard')" data-tab="dashboard" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-all bg-brand-600 text-white shadow-sm">
                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                    <span>Dashboard Overview</span>
                </button>
                <button onclick="switchTab('students')" data-tab="students" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800/80 hover:text-white transition-all">
                    <i data-lucide="users" class="w-4 h-4"></i>
                    <span>Student Directory</span>
                    <span id="nav-student-count" class="ml-auto text-xs bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full">12</span>
                </button>
                <button onclick="switchTab('gradebook')" data-tab="gradebook" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800/80 hover:text-white transition-all">
                    <i data-lucide="book-open-check" class="w-4 h-4"></i>
                    <span>Gradebook & Courses</span>
                </button>
                <button onclick="switchTab('attendance')" data-tab="attendance" class="nav-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800/80 hover:text-white transition-all">
                    <i data-lucide="calendar-check-2" class="w-4 h-4"></i>
                    <span>Attendance Tracker</span>
                </button>
            </nav>

            <!-- Footer Actions -->
            <div class="p-4 border-t border-slate-800/80 space-y-2">
                <button onclick="openEnrollModal()" class="w-full flex items-center justify-center gap-2 bg-white hover:bg-slate-100 text-navy-900 font-semibold text-xs py-2.5 px-4 rounded-xl transition-colors shadow-sm">
                    <i data-lucide="user-plus" class="w-4 h-4 text-brand-600"></i>
                    <span>Enroll New Student</span>
                </button>
                <button onclick="confirmResetDemoData()" class="w-full flex items-center justify-center gap-2 bg-slate-800/60 hover:bg-slate-800 text-slate-400 hover:text-slate-200 font-medium text-xs py-2 px-4 rounded-xl transition-colors">
                    <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                    <span>Reset Demo Data</span>
                </button>
            </div>
        </aside>

        <!-- Mobile Backdrop -->
        <div id="sidebar-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-30 hidden lg:hidden" onclick="toggleMobileSidebar()"></div>

        <!-- Main Workspace Content -->
        <main class="flex-1 flex flex-col min-w-0">
            
            <!-- Top Context Header -->
            <header class="bg-white border-b border-slate-200/80 px-6 py-4 sticky top-0 z-20 hidden lg:flex items-center justify-between">
                <div>
                    <h2 id="page-title" class="font-display font-bold text-xl text-slate-900">Dashboard Overview</h2>
                    <p id="page-subtitle" class="text-xs text-slate-500 mt-0.5">Institutional academic performance, enrollment metrics, and registrar alerts.</p>
                </div>
                <div class="flex items-center gap-4">
                    <div class="relative">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                        <input type="text" id="global-quick-search" placeholder="Quick lookup by Roll No or Name..." 
                            class="pl-9 pr-4 py-2 bg-slate-100 border border-transparent focus:bg-white focus:border-brand-500 rounded-xl text-xs w-64 transition-all outline-none"
                            onkeyup="handleGlobalSearch(event)">
                    </div>
                    <div class="h-6 w-px bg-slate-200"></div>
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-full bg-brand-100 text-brand-700 font-bold text-xs flex items-center justify-center border border-brand-200">
                            AR
                        </div>
                        <div class="text-left">
                            <p class="text-xs font-semibold text-slate-800 leading-none">Office of Registrar</p>
                            <p class="text-[11px] text-slate-500 mt-0.5">Admin Access</p>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Views Container -->
            <div class="p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">

                <!-- ==================== VIEW 1: DASHBOARD OVERVIEW ==================== -->
                <section id="view-dashboard" class="view-section space-y-6">
                    
                    <!-- KPI Cards -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 sm:gap-5">
                        <!-- KPI 1 -->
                        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Enrolled</span>
                                <div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center">
                                    <i data-lucide="users" class="w-5 h-5"></i>
                                </div>
                            </div>
                            <div class="mt-3 flex items-baseline gap-2.5">
                                <span id="kpi-total-students" class="font-display font-bold text-3xl text-slate-900">12</span>
                                <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">+4.2% vs last term</span>
                            </div>
                            <p class="text-xs text-slate-400 mt-2">Across 4 academic departments</p>
                        </div>

                        <!-- KPI 2 -->
                        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Institutional CGPA</span>
                                <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                                    <i data-lucide="award" class="w-5 h-5"></i>
                                </div>
                            </div>
                            <div class="mt-3 flex items-baseline gap-2.5">
                                <span id="kpi-avg-gpa" class="font-display font-bold text-3xl text-slate-900">3.48</span>
                                <span class="text-xs font-medium text-slate-500">/ 4.00 Scale</span>
                            </div>
                            <p id="kpi-deans-list" class="text-xs text-slate-400 mt-2">5 students on Dean's Honors List</p>
                        </div>

                        <!-- KPI 3 -->
                        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Avg. Attendance</span>
                                <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                                    <i data-lucide="user-check" class="w-5 h-5"></i>
                                </div>
                            </div>
                            <div class="mt-3 flex items-baseline gap-2.5">
                                <span id="kpi-avg-attendance" class="font-display font-bold text-3xl text-slate-900">88.4%</span>
                                <span id="kpi-low-attendance-badge" class="text-xs font-medium text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full">2 below 75%</span>
                            </div>
                            <p class="text-xs text-slate-400 mt-2">Minimum threshold: 75.0% required</p>
                        </div>

                        <!-- KPI 4 -->
                        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Active Courses</span>
                                <div class="w-9 h-9 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                                    <i data-lucide="library" class="w-5 h-5"></i>
                                </div>
                            </div>
                            <div class="mt-3 flex items-baseline gap-2.5">
                                <span id="kpi-active-courses" class="font-display font-bold text-3xl text-slate-900">8</span>
                                <span class="text-xs font-medium text-sky-700 bg-sky-50 px-2 py-0.5 rounded-full">28 Total Credits</span>
                            </div>
                            <p class="text-xs text-slate-400 mt-2">Mid-semester evaluations active</p>
                        </div>
                    </div>

                    <!-- Middle Row: GPA Distribution & Academic Alerts -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        
                        <!-- CGPA Distribution & Department Breakdown -->
                        <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between">
                            <div>
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
                                    <div>
                                        <h3 class="font-display font-bold text-base text-slate-900">Academic Standing & CGPA Distribution</h3>
                                        <p class="text-xs text-slate-500">Live cohort distribution across grading tiers</p>
                                    </div>
                                    <button onclick="switchTab('students')" class="text-xs font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-1">
                                        View Full Roster <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>

                                <!-- Interactive Visual Bar Chart -->
                                <div id="gpa-distribution-bars" class="space-y-4">
                                    <!-- Populated dynamically by JS -->
                                </div>
                            </div>

                            <!-- Department Summary Strip -->
                            <div class="mt-6 pt-5 border-t border-slate-100 grid grid-cols-2 sm:grid-cols-4 gap-3" id="dept-summary-grid">
                                <!-- Populated dynamically by JS -->
                            </div>
                        </div>

                        <!-- Academic Alerts & Quick Actions -->
                        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="font-display font-bold text-base text-slate-900">Registrar Alerts & Notices</h3>
                                    <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                                </div>
                                <div id="academic-alerts-list" class="space-y-3 max-h-72 overflow-y-auto pr-1">
                                    <!-- Populated dynamically by JS -->
                                </div>
                            </div>

                            <div class="mt-5 pt-4 border-t border-slate-100">
                                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-2.5">Quick Registrar Actions</p>
                                <div class="grid grid-cols-2 gap-2">
                                    <button onclick="openEnrollModal()" class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-brand-50 hover:bg-brand-100 text-brand-700 font-semibold text-xs transition-colors">
                                        <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> Enroll Student
                                    </button>
                                    <button onclick="switchTab('gradebook')" class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs transition-colors">
                                        <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Enter Grades
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Performers Spotlight Table -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
                        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                            <div>
                                <h3 class="font-display font-bold text-base text-slate-900">Dean's Honors List — Top Academic Performers</h3>
                                <p class="text-xs text-slate-500">Students maintaining CGPA ≥ 3.70 and Attendance ≥ 85%</p>
                            </div>
                            <span class="text-xs font-medium text-brand-700 bg-brand-50 px-3 py-1 rounded-full">Fall 2026</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-50/70 text-[11px] font-semibold uppercase tracking-wider text-slate-500 border-b border-slate-100">
                                        <th class="py-3 px-6">Student</th>
                                        <th class="py-3 px-4">Program</th>
                                        <th class="py-3 px-4">Semester</th>
                                        <th class="py-3 px-4">CGPA</th>
                                        <th class="py-3 px-4">Attendance</th>
                                        <th class="py-3 px-6 text-right">Transcript</th>
                                    </tr>
                                </thead>
                                <tbody id="deans-list-tbody" class="divide-y divide-slate-100 text-sm">
                                    <!-- Populated by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- ==================== VIEW 2: STUDENT DIRECTORY & RECORDS ==================== -->
                <section id="view-students" class="view-section hidden space-y-5">
                    
                    <!-- Filter & Search Toolbar -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 p-4 sm:p-5 shadow-xs space-y-4">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div class="relative flex-1">
                                <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                                <input type="text" id="directory-search" placeholder="Search by student name, roll number, or email..." 
                                    class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 focus:bg-white focus:border-brand-500 rounded-xl text-sm outline-none transition-all"
                                    oninput="renderStudentDirectory()">
                            </div>
                            <div class="flex flex-wrap items-center gap-2.5">
                                <select id="filter-department" onchange="renderStudentDirectory()" class="bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-700 outline-none focus:border-brand-500">
                                    <option value="ALL">All Departments</option>
                                    <option value="Computer Science">Computer Science</option>
                                    <option value="Data Science">Data Science</option>
                                    <option value="Electrical Engineering">Electrical Engineering</option>
                                    <option value="Business Administration">Business Administration</option>
                                </select>

                                <select id="filter-semester" onchange="renderStudentDirectory()" class="bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-700 outline-none focus:border-brand-500">
                                    <option value="ALL">All Semesters</option>
                                    <option value="1">Semester 1</option>
                                    <option value="2">Semester 2</option>
                                    <option value="3">Semester 3</option>
                                    <option value="4">Semester 4</option>
                                    <option value="5">Semester 5</option>
                                    <option value="6">Semester 6</option>
                                    <option value="7">Semester 7</option>
                                    <option value="8">Semester 8</option>
                                </select>

                                <select id="filter-standing" onchange="renderStudentDirectory()" class="bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-700 outline-none focus:border-brand-500">
                                    <option value="ALL">All Standings</option>
                                    <option value="Dean's List">Dean's List</option>
                                    <option value="Good Standing">Good Standing</option>
                                    <option value="Academic Probation">Academic Probation</option>
                                </select>

                                <button onclick="openEnrollModal()" class="bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs px-4 py-2.5 rounded-xl inline-flex items-center gap-1.5 shadow-xs transition-colors">
                                    <i data-lucide="user-plus" class="w-4 h-4"></i> Add Student
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Students Table Card -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-50 text-[11px] font-semibold uppercase tracking-wider text-slate-500 border-b border-slate-200/80">
                                        <th class="py-3.5 px-5">Roll No</th>
                                        <th class="py-3.5 px-4">Student Name</th>
                                        <th class="py-3.5 px-4">Program / Dept</th>
                                        <th class="py-3.5 px-4 text-center">Sem</th>
                                        <th class="py-3.5 px-4 text-center">CGPA</th>
                                        <th class="py-3.5 px-4">Attendance</th>
                                        <th class="py-3.5 px-4">Academic Standing</th>
                                        <th class="py-3.5 px-5 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="directory-tbody" class="divide-y divide-slate-100 text-sm">
                                    <!-- Populated dynamically by JS -->
                                </tbody>
                            </table>
                        </div>
                        <div id="directory-empty-state" class="hidden py-12 text-center">
                            <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3">
                                <i data-lucide="search-x" class="w-6 h-6"></i>
                            </div>
                            <p class="text-sm font-semibold text-slate-700">No matching student records found</p>
                            <p class="text-xs text-slate-500 mt-1">Try clearing filters or searching with a different keyword.</p>
                        </div>
                    </div>
                </section>

                <!-- ==================== VIEW 3: GRADEBOOK & COURSE MANAGEMENT ==================== -->
                <section id="view-gradebook" class="view-section hidden space-y-6">
                    
                    <!-- Course Cards Grid -->
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <div>
                                <h3 class="font-display font-bold text-base text-slate-900">Active Curriculum & Course Catalog</h3>
                                <p class="text-xs text-slate-500">Select a course below to inspect or update student grades</p>
                            </div>
                        </div>
                        <div id="courses-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                            <!-- Populated dynamically by JS -->
                        </div>
                    </div>

                    <!-- Interactive Grade Entry & Transcript Table -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
                        <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-50/50">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span id="selected-course-code" class="text-xs font-bold bg-brand-600 text-white px-2.5 py-0.5 rounded-md">CS301</span>
                                    <h3 id="selected-course-title" class="font-display font-bold text-base text-slate-900">Data Structures & Algorithms</h3>
                                </div>
